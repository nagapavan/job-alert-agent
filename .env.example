# Copy to `.env` and adjust as needed. All values are optional — the app runs
# with sensible local defaults out of the box.

# --- Database -----------------------------------------------------------------
# Defaults to a local SQLite file (job_alert_agent.db) when unset.
# For large job sets, use PostgreSQL + pgvector:
# DATABASE_URL=postgresql://user:password@localhost:5432/job_alert_agent
DATABASE_URL=sqlite:///./job_alert_agent.db

# --- LLM providers (local-first) ---------------------------------------------
DEFAULT_LLM_PROVIDER=auto
LM_STUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434
ALLOW_CLOUD_FALLBACK=false
# Cloud keys are normally set via the encrypted Settings UI; env vars override them.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Security -----------------------------------------------------------------
# Extra browser origins allowed to call the API (comma-separated).
# ALLOWED_ORIGINS=https://my-host:8000
# Explicit Chrome extension IDs trusted for CORS (comma-separated). Empty = none.
# ALLOWED_EXTENSION_IDS=abcdefghijklmnopabcdefghijklmnop
# Override the auto-generated API key / encryption key (not recommended for local use).
# JOB_ALERT_AGENT_API_KEY=
# JOB_ALERT_AGENT_SECRET_KEY=

# --- Structured log & operation-log retention ---------------------------------
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
OPERATION_LOG_MAX_ROWS=1000
OPERATION_LOG_RETENTION_DAYS=30
OPERATION_LOG_PRUNE_INTERVAL_SECONDS=3600
